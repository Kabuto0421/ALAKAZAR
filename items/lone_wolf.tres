script = ExtResource("1")
id = "lone_wolf"
title = "一匹狼の妖精"
description = "全武器の範囲外の空きマスに\n召喚。HP{hp}・AP{ally_ap}。銀の動きで\n1歩ずつ近づき、届く敵に噛む。\n単独で{wolf_bite}、隣に誰かいると{wolf_crowded}。\n武器が届く所ではすねる。"
