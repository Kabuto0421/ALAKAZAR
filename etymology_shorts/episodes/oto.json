            { "at": 0.15, "state": { "left": 3 }, "sfx": "pop" },
            { "at": 0.45, "state": { "right": 3 }, "sfx": "pop" },
            { "at": 0.7, "sfx": "boom", "flash": 0.3, "shake": 8 }
          ]
        },
        {
          "text": "さあ、{音}の旅に出ましょう。",
          "say": "さあ、音の旅に、出ましょう。",
          "voice": { "speed": 1.25 },
