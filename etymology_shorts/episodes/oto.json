    {
      "id": "greece",
      "stop": "ギリシャ",
      "era": -400,
      "camera": { "lon": 23, "lat": 39, "zoom": 3.4 },
      "lines": [
        { "text": "まずはギリシャ。声や音のことを {phōnē} と呼んだの。", "say": "まずはギリシャ。声や、音のことを、フォーネーと呼んだの。", "cards": ["phone"], "mark": ["athens"], "fx": [{ "at": 0.0, "sfx": "pop", "punch": 0.03 }, { "at": 0.7, "sfx": "shine", "flash": 0.3 }] },
        { "text": "「遠く」＋「音」で {telephone}、電話。", "say": "遠く、プラス、音で、テレフォン。電話。", "cards": ["phonetable"], "cardState": { "rows": 1 }, "fx": [{ "at": 0.1, "sfx": "pop" }, { "at": 0.75, "sfx": "pop" }] },
        { "text": "「小さい」＋「音」で {microphone}、マイク。", "say": "小さい、プラス、音で、マイクロフォン。マイク。", "cardState": { "rows": 2 }, "fx": [{ "at": 0.1, "sfx": "pop" }] },
        { "text": "「一緒に」＋「音」で {symphony}、交響曲ね。", "say": "一緒に、プラス、音で、シンフォニー。交響曲ね。", "cardState": { "rows": 3 }, "fx": [{ "at": 0.1, "sfx": "pop" }, { "at": 0.8, "sfx": "shine", "flash": 0.25 }] }
      ]
    },
    {
      "id": "rome",
      "stop": "ローマ",
      "era": -100,
      "camera": { "lon": 8, "lat": 46, "zoom": 2.6 },
      "lines": [
        { "text": "一方ローマでは、音のことを {sonus}。", "say": "一方ローマでは、音のことを、ソヌス。", "cards": ["sonus"], "mark": ["rome"], "routes": [{ "id": "r1", "path": ["athens", "rome"], "style": "faith", "len": 0.7 }], "fx": [{ "at": 0.75, "sfx": "boom", "flash": 0.3, "shake": 8 }] },
        { "text": "ここから、ソナタ、ユニゾン、共鳴……{たくさんの言葉}が生まれたの。", "say": "ここから、ソナタ、ユニゾン、共鳴。たくさんの言葉が、生まれたの。", "cards": ["sontree"], "fx": [{ "at": 0.75, "state": { "hl": 1 }, "sfx": "shine", "flash": 0.3, "punch": 0.03 }] },
        { "text": "フランスを通って、英語の {sound} にもなったわ。", "say": "フランスを通って、英語の、サウンドにもなったわ。", "cards": ["tosound"], "era": 1300, "routes": [{ "id": "r2", "path": ["rome", "paris", "london"], "style": "faith", "len": 0.8, "labelEnd": "sound" }], "fx": [{ "at": 0.1, "sfx": "whoosh" }] },
        { "text": "実は sound の {d} は、あとから付け足された{おまけ}なのよ。", "say": "実は、サウンドの、ディーは、あとから付け足された、おまけなのよ。", "cards": ["plusd"], "era": 1450, "fx": [{ "at": 0.35, "pop": "d!?", "sfx": "boom", "shake": 12, "flash": 0.35 }] }
      ]
    },
    {
      "id": "china",
      "stop": "中国",
      "era": -1000,
      "camera": { "lon": 112, "lat": 34, "zoom": 2.6 },
      "lines": [
        { "text": "今度は東へ。漢字の{「音」}は、もともと{「言」}と同じ字だったの。", "say": "今度は東へ。漢字の、音は、もともと、言と同じ字だったの。", "cards": ["gensame"], "mark": ["china"], "fx": [{ "at": 0.7, "sfx": "boom", "flash": 0.4, "shake": 10 }] },
        { "text": "「言」の口の中に{一本の線}を足して、「音」にしたのよ。", "say": "言の口の中に、一本の線を足して、音にしたのよ。", "cards": ["kouline"], "fx": [{ "at": 0.3, "sfx": "pop" }, { "at": 0.7, "sfx": "shine", "flash": 0.3 }] }
      ]
    },
    {
      "id": "japan",
      "stop": "日本",
      "era": null,
      "camera": { "lon": 128, "lat": 35, "zoom": 2.4 },
      "lines": [
        { "text": "日本では、音を{「おと」}と読むわね。", "say": "日本では、音を、おとと読むわね。", "mark": ["nara"], "routes": [{ "id": "j1", "path": ["china", "nara"], "style": "east", "len": 0.6, "labelEnd": "おと" }], "fx": [{ "at": 0.1, "sfx": "whoosh" }] },
        { "text": "実は{「訪れる」}は、「音を連れてくる」から生まれた言葉なのよ。", "say": "実は、訪れるは、音を連れてくる、から生まれた言葉なのよ。", "cards": ["otozure"], "fx": [{ "at": 0.3, "pop": "訪れる!?", "sfx": "boom", "shake": 10, "flash": 0.3 }] },
        { "text": "誰かが来るときは、いつも{音が先に届く}……素敵な考え方ね。", "say": "誰かが来るときは、いつも、音が先に届く。素敵な考え方ね。", "fx": [{ "at": 0.5, "sfx": "shine", "flash": 0.2 }] }
      ]
    },
    {
      "id": "outro",
      "stop": "旅の終わりに",
      "era": 2026,
      "camera": { "lon": 60, "lat": 38, "zoom": 0.92, "spin": -2 },
      "lines": [
        { "text": "音って、当たり前にそこにあるけれど、", "say": "音って、当たり前に、そこにあるけれど、", "fx": [{ "at": 0.3, "sfx": "shine", "glowAll": true }] },
        { "text": "遡ってみると、人はいろんな形で{音を言葉に}してきたのね。", "say": "遡ってみると、人は、いろんな形で、音を言葉にしてきたのね。" },
        {
          "text": "{フォン}、{ソナタ}、{サウンド}、{音}、そして{訪れ}。",
          "say": "フォン、ソナタ、サウンド、音、そして、訪れ。",
          "cards": ["endwall"],
          "fx": [
            { "at": 0.0, "sfx": "boom", "flash": 0.5, "shake": 10 },
            { "at": 0.2, "sfx": "pop" }, { "at": 0.4, "sfx": "pop" }, { "at": 0.6, "sfx": "pop" }, { "at": 0.8, "sfx": "pop" },
            { "at": 0.95, "id": "done", "sfx": "shine", "flash": 0.3 }
          ]
        },
        { "text": "次に何かの音が聞こえたら、ちょっと{耳を澄ませてみてね}。", "say": "次に、何かの音が聞こえたら、ちょっと、耳を澄ませてみてね。" }
      ]
    }
