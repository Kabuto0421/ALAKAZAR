      "camera": { "lon": 40, "lat": 40, "zoom": 0.9, "spin": 16 },
      "lines": [
        {
          "text": "スマホ、マイク、ソナタ、サウンド。ぜんぶ{「音」}という意味が隠れているのよ。",
          "say": "スマホ、マイク、ソナタ、サウンド。ぜんぶ、音という意味が、隠れているのよ。",
          "voice": { "speed": 1.25 },
          "cards": ["hookwall"],
          "fx": [
            { "at": 0.0, "sfx": "boom", "flash": 0.8, "shake": 14 },
            { "at": 0.1, "sfx": "pop" }, { "at": 0.2, "sfx": "pop" }, { "at": 0.3, "sfx": "pop" }, { "at": 0.4, "sfx": "pop" },
            { "at": 0.5, "id": "done", "sfx": "pop" },
            { "at": 0.72, "id": "hl", "sfx": "shine", "flash": 0.4, "punch": 0.04 }
          ]
        },
        {
          "text": "その正体は、{ギリシャ}と{ローマ}の、2つの古い言葉。",
          "say": "その正体は、ギリシャと、ローマの、2つの古い言葉。",
          "voice": { "speed": 1.25 },
          "cards": ["twofamilies"],
